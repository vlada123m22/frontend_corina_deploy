server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Proxy /api/* to backend, STRIPPING the /api prefix
    location /api/ {
        # Handle CORS preflight requests
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '$http_origin' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization, X-Requested-With' always;
            add_header 'Access-Control-Max-Age' '86400' always;
            add_header 'Content-Length' '0' always;
            return 204;
        }

        # Use https:// for HTTPS backends (like render.com)
        # If your backend is HTTP-only, change https:// to http://
        proxy_pass https://${BACKEND_HOST}/;         # trailing slash is critical
        proxy_http_version 1.1;
        
        # Set Host header to the actual backend domain (required for SNI and backend routing)
        proxy_set_header Host              ${BACKEND_HOST};
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Origin            $http_origin;
        
        # HTTPS-specific settings
        proxy_ssl_verify off;                        # For self-signed certs
        proxy_ssl_session_reuse on;
        proxy_ssl_server_name on;                    # Enable SNI (Server Name Indication) for proper SSL handshake
        proxy_ssl_protocols TLSv1.2 TLSv1.3;         # Use modern TLS versions

        # Add CORS headers to all responses
        add_header 'Access-Control-Allow-Origin' '$http_origin' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization, X-Requested-With' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
    }

    # SPA fallback for React Router
    location / {
        try_files $uri $uri/ /index.html;
    }
}